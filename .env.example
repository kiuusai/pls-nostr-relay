POSTGRES_DB=nostr
POSTGRES_USER=nostr
POSTGRES_PASSWORD=nostr

# Relay settings used by the relay container
RELAY_HOST_PORT=8080 # Port exposed on `docker compose up` command
RELAY_PORT=8080
DATABASE_URL=postgresql://nostr:nostr@postgres:5432/nostr
RELAY_URL=ws://localhost:8080/
RELAY_NAME=Private Law Society Nostr relay
RELAY_DESCRIPTION=Private Law Society Nostr relay.
REJECT_FUTURE_SECONDS=1800
SUBSCRIPTIONS_PER_MIN=10
